# CRM Nossa Ótica - Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com as credenciais do seu Supabase
# (Project Settings → API Keys). A chave "publishable/anon" é pública por design;
# a segurança dos dados é garantida pelas políticas RLS no banco.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CRM Nossa Ótica
